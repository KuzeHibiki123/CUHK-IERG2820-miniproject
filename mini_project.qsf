# Portable project for the requested device. No board pin assignments.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY mini_project_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build/quartus_project
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name VERILOG_FILE rtl/hex7_decoder.v
set_global_assignment -name VERILOG_FILE rtl/c1_display.v
set_global_assignment -name VERILOG_FILE rtl/c2_display.v
set_global_assignment -name VERILOG_FILE rtl/c3_display.v
set_global_assignment -name VERILOG_FILE rtl/display_formatter.v
set_global_assignment -name VERILOG_FILE rtl/input_filter.v
set_global_assignment -name VERILOG_FILE rtl/clock_enable.v
set_global_assignment -name VERILOG_FILE rtl/question1.v
set_global_assignment -name VERILOG_FILE rtl/question2.v
set_global_assignment -name VERILOG_FILE rtl/mini_project_top.v
set_global_assignment -name SDC_FILE mini_project.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_location_assignment PIN_136 -to SW2
set_location_assignment PIN_87 -to K[1]
set_location_assignment PIN_101 -to K[2]
# PIN_101 is dual-purpose nCEO; K2 requires it as user I/O after configuration.
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_location_assignment PIN_113 -to K[4]
set_location_assignment PIN_143 -to T[12]
# Additional board locations from Pin_Assignment.txt (2026-10-13).
# Original project contents above are preserved.
# Source aliases are mapped to the actual top-level ports by physical labels.
# C3[12:15] uses the table values 80, 76, 74, 72, as confirmed by the user.

# Clock and switches
set_location_assignment PIN_90 -to CLK_50
set_location_assignment PIN_120 -to SW1

# Touch keys T1 through T11
set_location_assignment PIN_132 -to T[1]
set_location_assignment PIN_135 -to T[2]
set_location_assignment PIN_137 -to T[3]
set_location_assignment PIN_141 -to T[4]
set_location_assignment PIN_2 -to T[5]
set_location_assignment PIN_144 -to T[6]
set_location_assignment PIN_142 -to T[7]
set_location_assignment PIN_138 -to T[8]
set_location_assignment PIN_10 -to T[9]
set_location_assignment PIN_1 -to T[10]
set_location_assignment PIN_3 -to T[11]

# LEDs (physical LED numbering starts at 1)
set_location_assignment PIN_86 -to LED[1]
set_location_assignment PIN_98 -to LED[2]
set_location_assignment PIN_100 -to LED[3]
set_location_assignment PIN_103 -to LED[4]
set_location_assignment PIN_105 -to LED[5]
set_location_assignment PIN_110 -to LED[6]
set_location_assignment PIN_112 -to LED[7]
set_location_assignment PIN_114 -to LED[8]
set_location_assignment PIN_119 -to LED[9]

# C1: A, B, C, D, E, F, G
set_location_assignment PIN_80 -to C1[0]
set_location_assignment PIN_83 -to C1[1]
set_location_assignment PIN_77 -to C1[2]
set_location_assignment PIN_75 -to C1[3]
set_location_assignment PIN_73 -to C1[4]
set_location_assignment PIN_71 -to C1[5]
set_location_assignment PIN_69 -to C1[6]

# C2: A, B, C, D, E, F, G
set_location_assignment PIN_72 -to C2[0]
set_location_assignment PIN_74 -to C2[1]
set_location_assignment PIN_76 -to C2[2]
set_location_assignment PIN_32 -to C2[3]
set_location_assignment PIN_34 -to C2[4]
set_location_assignment PIN_39 -to C2[5]
set_location_assignment PIN_43 -to C2[6]

# C3: A1, A2, B, C, D1, D2, E, F, G1, G2, H, J, K, L, M, N
set_location_assignment PIN_11 -to C3[0]
set_location_assignment PIN_7 -to C3[1]
set_location_assignment PIN_49 -to C3[2]
set_location_assignment PIN_51 -to C3[3]
set_location_assignment PIN_53 -to C3[4]
set_location_assignment PIN_55 -to C3[5]
set_location_assignment PIN_59 -to C3[6]
set_location_assignment PIN_28 -to C3[7]
set_location_assignment PIN_31 -to C3[8]
set_location_assignment PIN_33 -to C3[9]
set_location_assignment PIN_38 -to C3[10]
set_location_assignment PIN_42 -to C3[11]
set_location_assignment PIN_44 -to C3[12]
set_location_assignment PIN_50 -to C3[13]
set_location_assignment PIN_30 -to C3[14]
set_location_assignment PIN_58 -to C3[15]

# Awaiting board pin numbers: LED[11:15].
# No board pin numbers supplied for unused K[3], C3[16].

set_location_assignment PIN_67 -to C1[7]
set_location_assignment PIN_46 -to C2[7]
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
# Placement seed selected during K2 clock-switch timing validation.
set_global_assignment -name SEED 6


set_global_assignment -name VERILOG_FILE rtl/registered_display_rom.v

set_global_assignment -name CDF_FILE "build/quartus_project/mini-project_final.cdf"
set_location_assignment PIN_54 -to C3[16]
set_location_assignment PIN_104 -to K[3]
set_global_assignment -name CDF_FILE build/quartus_project/Chain1.cdf
set_location_assignment PIN_127 -to LED[10]
set_location_assignment PIN_126 -to LED[15]
set_location_assignment PIN_133 -to LED[16]
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top