# Portable project for the requested device. No board pin assignments.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY mini_project_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build/quartus_project
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name OPTIMIZATION_TECHNIQUE BALANCED
set_global_assignment -name VERILOG_FILE rtl/hex7_decoder.v
set_global_assignment -name VERILOG_FILE rtl/c1_display.v
set_global_assignment -name VERILOG_FILE rtl/c2_display.v
set_global_assignment -name VERILOG_FILE rtl/c3_display.v
set_global_assignment -name VERILOG_FILE rtl/display_formatter.v
set_global_assignment -name VERILOG_FILE rtl/input_filter.v
set_global_assignment -name VERILOG_FILE rtl/clock_enable.v
set_global_assignment -name VERILOG_FILE rtl/question1.v
set_global_assignment -name VERILOG_FILE rtl/question2.v
set_global_assignment -name VERILOG_FILE rtl/mini_project_top.v
set_global_assignment -name SDC_FILE mini_project.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_location_assignment PIN_10 -to SW2
set_location_assignment PIN_99 -to K[1]
set_location_assignment PIN_106 -to K[4]
set_location_assignment PIN_3 -to T[12]
# Additional board locations from Pin_Assignment.txt (2026-10-13).
# Original project contents above are preserved.
# Source aliases are mapped to the actual top-level ports by physical labels.
# C3[12:15] uses the table values 80, 76, 74, 72, as confirmed by the user.

# Clock and switches
set_location_assignment PIN_23 -to CLK_50
set_location_assignment PIN_11 -to SW1

# Touch keys T1 through T11
set_location_assignment PIN_28 -to T[1]
set_location_assignment PIN_31 -to T[2]
set_location_assignment PIN_33 -to T[3]
set_location_assignment PIN_38 -to T[4]
set_location_assignment PIN_42 -to T[5]
set_location_assignment PIN_44 -to T[6]
set_location_assignment PIN_50 -to T[7]
set_location_assignment PIN_52 -to T[8]
set_location_assignment PIN_54 -to T[9]
set_location_assignment PIN_58 -to T[10]
set_location_assignment PIN_49 -to T[11]

# LEDs (physical LED numbering starts at 1)
set_location_assignment PIN_43 -to LED[1]
set_location_assignment PIN_46 -to LED[2]
set_location_assignment PIN_85 -to LED[3]
set_location_assignment PIN_84 -to LED[4]
set_location_assignment PIN_83 -to LED[5]
set_location_assignment PIN_77 -to LED[6]
set_location_assignment PIN_75 -to LED[7]
set_location_assignment PIN_73 -to LED[8]
set_location_assignment PIN_71 -to LED[9]
set_location_assignment PIN_69 -to LED[16]

# C1: A, B, C, D, E, F, G
set_location_assignment PIN_67 -to C1[0]
set_location_assignment PIN_65 -to C1[1]
set_location_assignment PIN_60 -to C1[2]
set_location_assignment PIN_39 -to C1[3]
set_location_assignment PIN_34 -to C1[4]
set_location_assignment PIN_32 -to C1[5]
set_location_assignment PIN_30 -to C1[6]

# C2: A, B, C, D, E, F, G
set_location_assignment PIN_144 -to C2[0]
set_location_assignment PIN_142 -to C2[1]
set_location_assignment PIN_138 -to C2[2]
set_location_assignment PIN_136 -to C2[3]
set_location_assignment PIN_133 -to C2[4]
set_location_assignment PIN_129 -to C2[5]
set_location_assignment PIN_127 -to C2[6]

# C3: A1, A2, B, C, D1, D2, E, F, G1, G2, H, J, K, L, M, N
set_location_assignment PIN_125 -to C3[0]
set_location_assignment PIN_121 -to C3[1]
set_location_assignment PIN_119 -to C3[2]
set_location_assignment PIN_114 -to C3[3]
set_location_assignment PIN_112 -to C3[4]
set_location_assignment PIN_110 -to C3[5]
set_location_assignment PIN_105 -to C3[6]
set_location_assignment PIN_103 -to C3[7]
set_location_assignment PIN_100 -to C3[8]
set_location_assignment PIN_98 -to C3[9]
set_location_assignment PIN_86 -to C3[10]
set_location_assignment PIN_87 -to C3[11]
set_location_assignment PIN_80 -to C3[12]
set_location_assignment PIN_76 -to C3[13]
set_location_assignment PIN_74 -to C3[14]
set_location_assignment PIN_72 -to C3[15]

# Awaiting board pin numbers: C1[7], C2[7], LED[10:15], CCLK.
# No board pin numbers supplied for unused K[2], K[3], C3[16].

set_location_assignment PIN_70 -to C1[7]
set_location_assignment PIN_68 -to C2[7]
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name CDF_FILE build/quartus_project/mini_project.cdf
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top